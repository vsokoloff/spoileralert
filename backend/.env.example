# ── Spoiler Alert backend environment ────────────────────────────────────────
# Copy this file to ".env" and fill in your OWN values. Never commit ".env".

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database connection.
# Local dev (no setup needed) — leave as SQLite:
DATABASE_URL=sqlite:///./spoiler_alert.db
# Production (Render sets this automatically from the managed Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/spoileralert

# Google Gemini key — powers receipt scanning AND the SPOY recipe assistant.
# Free, no billing required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# The deployed frontend URL, used for CORS in production (no trailing slash).
# Leave blank for local development.
FRONTEND_URL=
